# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
PUBLIC_ORIGIN=https://your-domain.example
KASPA_NETWORK=testnet            # testnet | mainnet
SILVERC_PATH=/usr/local/bin/silverc

# Kaspa node
KASPA_NODE_RPC=
MIN_FEE_SOMPI_PER_GRAM=
MIN_CHANGE_SOMPI=

# Database (MySQL)
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=silverscript_studio

# Auth (kasperopay's session signing secret)
JWT_SECRET=

# AI contract generator (optional)
ANTHROPIC_API_KEY=
AI_MODEL=

# Delivery notarization via KaspaNotary (optional)
KEYSTONE_API_URL=
KEYSTONE_API_KEY=

