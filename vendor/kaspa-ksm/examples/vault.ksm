  "source": {
    "language": "silverscript",
    "contract": "Vault",
    "text": "contract Vault(pubkey owner, pubkey funder) {\n  entry spend(sig ownerSig) { require(checkSig(ownerSig, owner)); }\n  entry reclaim(sig funderSig) { require(this.ageDaa >= 864000); require(checkSig(funderSig, funder)); }\n}"
  },
